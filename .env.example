# WSG-01 App & Backend Environment Variables
# Copy to .env for local configuration. Never commit actual secret keys!

# Client / Expo Public Keys
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
EXPO_PUBLIC_DEVICE_UUID=WSG-000001

# Supabase Edge Functions / Backend Secrets (Set in Supabase Dashboard Secrets or CLI)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Firebase Cloud Messaging (FCM HTTP v1) - Server-side only
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
