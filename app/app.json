{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "NSBluetoothAlwaysUsageDescription": "Washroom Safety Gadget uses Bluetooth to discover, connect, and maintain life-safety monitoring with your WSG-01 device in the background.",
        "NSBluetoothPeripheralUsageDescription": "Washroom Safety Gadget uses Bluetooth to communicate with your WSG-01 safety device.",
        "NSLocationWhenInUseUsageDescription": "Location access is used only to enable Bluetooth device scanning, as required by iOS. Your location is never stored or transmitted."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "package": "com.sanjuamazing.app"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "wsg-safety",
          "project": "wsg-01"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow Washroom Safety Gadget to connect to WSG-01 via Bluetooth in the background."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EF4444",
          "sounds": [
            "./assets/emergency_siren.wav"
          ]
        }
      ],
      "expo-secure-store",
      "@sentry/react-native"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e138e27e-ca73-416e-a6e8-49f4e1a1ebdf"
      }
    },
    "owner": "sanjuamazing"
  }
}
